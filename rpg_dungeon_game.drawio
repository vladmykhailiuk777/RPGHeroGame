        </mxCell>
        <mxCell id="43" parent="40" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" value="- generateLevel(): void&lt;br&gt;  — заповнює карту стінами (#)&lt;br&gt;  — вирізає прохід, ставить X в кут&lt;br&gt;  — розкидає E E $ ^ I I випадково&lt;br&gt;&lt;br&gt;- combat(e: Enemy): void&lt;br&gt;  — цикл: герой б&#39;є → ворог б&#39;є&lt;br&gt;  — шкода = atk - def + rand(0..4)&lt;br&gt;  — втеча: rand(0..9) &lt; luck → успіх&lt;br&gt;  — перемога: +40 XP, +20 gold&lt;br&gt;&lt;br&gt;- showInventory(): void&lt;br&gt;  — показує список Items, викликає useItem()&lt;br&gt;&lt;br&gt;- pickupItem(): void&lt;br&gt;  — бере випадковий Item з itemTable&lt;br&gt;  — додає якщо inventory &lt; 6&lt;br&gt;&lt;br&gt;+ draw(): void — малює карту з туманом&lt;br&gt;+ update(): void — читає W/A/S/D/I/Q&lt;br&gt;+ isRunning(): bool&lt;br&gt;+ showGameOver(): void" vertex="1">
          <mxGeometry height="336" width="360" y="144" as="geometry" />
        </mxCell>
        <mxCell id="60" parent="1" style="swimlane;fontStyle=1;align=center;startSize=26;whiteSpace=wrap;html=1;" value="Легенда карти" vertex="1">
          <mxGeometry height="230" width="290" x="960" y="860" as="geometry" />
        </mxCell>
        <mxCell id="61" parent="60" style="line;strokeWidth=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="8" width="290" y="26" as="geometry" />
        </mxCell>
        <mxCell id="62" parent="60" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" value="@  — гравець (поточна позиція)&lt;br&gt;#  — стіна (непрохідна клітинка)&lt;br&gt;.  — підлога (порожня клітинка)&lt;br&gt;?  — туман війни (не досліджено)&lt;br&gt;E  — ворог → запускає combat()&lt;br&gt;$  — золото → +50 gold&lt;br&gt;^  — пастка → -20 hp&lt;br&gt;I  — предмет → pickupItem()&lt;br&gt;X  — вихід → currentLevel++, новий рівень&lt;br&gt;&lt;br&gt;Туман: відкривається в радіусі 1 клітинки&lt;br&gt;Герой стартує завжди в позиції x=1 y=1&lt;br&gt;Вихід X завжди в правому нижньому куті" vertex="1">
          <mxGeometry height="196" width="290" y="34" as="geometry" />
        </mxCell>
        <mxCell id="70" parent="1" style="swimlane;fontStyle=1;align=center;startSize=26;whiteSpace=wrap;html=1;" value="Система XP і рівнів" vertex="1">
          <mxGeometry height="170" width="310" x="160" y="980" as="geometry" />
        </mxCell>
        <mxCell id="71" parent="70" style="line;strokeWidth=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="8" width="310" y="26" as="geometry" />
        </mxCell>
        <mxCell id="72" parent="70" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" value="Джерело XP: лише перемога в бою (+40)&lt;br&gt;Поріг рівня: 100 XP&lt;br&gt;Лишок XP переноситься на наступний рівень&lt;br&gt;  Приклад: 80 XP + 40 = 120 → level++, лишок 20&lt;br&gt;&lt;br&gt;При підвищенні рівня:&lt;br&gt;  maxHp + 20, hp = maxHp (повне відновлення)&lt;br&gt;  atk + 5&lt;br&gt;  def + 2" vertex="1">
          <mxGeometry height="136" width="310" y="34" as="geometry" />
        </mxCell>
        <mxCell id="80" parent="1" style="swimlane;fontStyle=1;align=center;startSize=26;whiteSpace=wrap;html=1;" value="Бій" vertex="1">
          <mxGeometry height="250" width="360" x="1100" y="560" as="geometry" />
        </mxCell>
        <mxCell id="81" parent="80" style="line;strokeWidth=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="8" width="360" y="26" as="geometry" />
        </mxCell>
        <mxCell id="82" parent="80" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" value="Тригер: гравець наступає на клітинку E&lt;br&gt;&lt;br&gt;Хід гравця — три варіанти:&lt;br&gt;  [1] Атака: pDmg = max(1, atk - e.def + rand(0..4))&lt;br&gt;  [2] Інвентар: відкрити і використати Item&lt;br&gt;  [3] Втеча: rand(0..9) &lt; luck → успіх, інакше&lt;br&gt;      hero.hp -= e.atk / 2&lt;br&gt;&lt;br&gt;Хід ворога (якщо живий після атаки гравця):&lt;br&gt;  eDmg = max(1, e.atk - hero.def + rand(0..2))&lt;br&gt;&lt;br&gt;Кінець бою:&lt;br&gt;  Перемога → +40 XP, +20 gold, cell = &#39;.&#39;&lt;br&gt;  Поразка  → hero.isAlive() == false → GameOver" vertex="1">
          <mxGeometry height="216" width="360" y="34" as="geometry" />
        </mxCell>
