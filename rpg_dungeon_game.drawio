        <mxCell id="41" parent="40" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" value="- map: vector&lt;string&gt; — реальна карта 8x18&lt;br&gt;- fog: vector&lt;string&gt; — туман (? = не видно)&lt;br&gt;- hero: Player — об&#39;єкт гравця&lt;br&gt;- currentLevel: int — поточний рівень&lt;br&gt;- running: bool — чи продовжується гра&lt;br&gt;- itemTable: vector&lt;Item&gt; — пул предметів" vertex="1">
          <mxGeometry height="110" width="360" y="26" as="geometry" />
